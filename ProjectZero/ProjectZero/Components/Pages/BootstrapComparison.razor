@page "/bootstrap-comparison"

<PageTitle>Bootstrap vs Plain HTML</PageTitle>

<h1>Bootstrap vs plain HTML</h1>

<p class="lead">
    Every block below shows the <em>same content</em> twice: unstyled HTML on the left,
    Bootstrap classes on the right. The whole page is built from one reusable component,
    <code>Compare.razor</code>, which takes two render fragments.
</p>

<hr/>

<Compare Title="Typography">
    <Plain>
        <h1>Heading h1</h1>
        <h2>Heading h2</h2>
        <h3>Heading h3</h3>
        <p>This is a plain paragraph of body text with no styling.</p>
        <strong>Bold text</strong>, <em>italic text</em>.
        <blockquote>A single quoted line.</blockquote>
    </Plain>
    <Bootstrapped>
        <h1 class="display-5">Heading h1</h1>
        <h2 class="h4">Heading h2</h2>
        <h3 class="h6">Heading h3</h3>
        <p class="lead">This is a lead paragraph: larger and lighter than body text.</p>
        <p><strong>Bold</strong>, <em>italic</em>, <mark>highlighted</mark> and <code>code</code>.</p>
        <blockquote class="blockquote">
            <p>A quoted line with attribution.</p>
            <footer class="blockquote-footer">Someone famous</footer>
        </blockquote>
    </Bootstrapped>
</Compare>

<Compare Title="Buttons">
    <Plain>
        <button>Default button</button>
    </Plain>
    <Bootstrapped>
        <button class="btn btn-primary">Primary</button>
        <button class="btn btn-secondary">Secondary</button>
        <button class="btn btn-success">Success</button>
        <button class="btn btn-danger">Danger</button>
        <button class="btn btn-warning">Warning</button>
        <button class="btn btn-info">Info</button>
        <button class="btn btn-outline-primary">Outline</button>
        <button class="btn btn-link">Link</button>
    </Bootstrapped>
</Compare>

<Compare Title="Badges and alerts">
    <Plain>
        <span>New</span>
        <span>3 errors</span>
        <div>A warning message.</div>
        <div>Everything worked.</div>
    </Plain>
    <Bootstrapped>
        <span class="badge text-bg-primary">New</span>
        <span class="badge text-bg-secondary">Draft</span>
        <span class="badge text-bg-success">Done</span>
        <span class="badge text-bg-danger">3 errors</span>
        <div class="alert alert-warning mt-2" role="alert">A warning message.</div>
        <div class="alert alert-success mt-2" role="alert">Everything worked.</div>
        <div class="alert alert-info mt-2" role="alert">
            Alerts have the <code>alert</code> class plus a color: <code>alert-warning</code>, ...
        </div>
    </Bootstrapped>
</Compare>

<Compare Title="Tables">
    <Plain>
        <table>
            <thead>
            <tr><th>#</th><th>Name</th><th>Role</th></tr>
            </thead>
            <tbody>
            <tr><td>1</td><td>Ada</td><td>Analyst</td></tr>
            <tr><td>2</td><td>Grace</td><td>Engineer</td></tr>
            <tr><td>3</td><td>Alan</td><td>Researcher</td></tr>
            </tbody>
        </table>
    </Plain>
    <Bootstrapped>
        <table class="table table-striped table-hover">
            <thead>
            <tr><th>#</th><th>Name</th><th>Role</th></tr>
            </thead>
            <tbody>
            <tr><td>1</td><td>Ada</td><td>Analyst</td></tr>
            <tr><td>2</td><td>Grace</td><td>Engineer</td></tr>
            <tr><td>3</td><td>Alan</td><td>Researcher</td></tr>
            </tbody>
        </table>
    </Bootstrapped>
</Compare>

<Compare Title="Forms">
    <Plain>
        <label>Name</label>
        <input type="text"/>
        <label>Country</label>
        <select>
            <option>Denmark</option>
            <option>Germany</option>
        </select>
        <label>Newsletter</label>
        <input type="checkbox"/>
    </Plain>
    <Bootstrapped>
        <div class="mb-3">
            <label class="form-label">Name</label>
            <input type="text" class="form-control" placeholder="Ada"/>
        </div>
        <div class="mb-3">
            <label class="form-label">Country</label>
            <select class="form-select">
                <option>Denmark</option>
                <option>Germany</option>
            </select>
        </div>
        <div class="form-check form-switch">
            <input class="form-check-input" type="checkbox" id="newsletterSwitch"/>
            <label class="form-check-label" for="newsletterSwitch">Newsletter</label>
        </div>
    </Bootstrapped>
</Compare>

<Compare Title="Lists">
    <Plain>
        <ul>
            <li>Item one</li>
            <li>Item two</li>
            <li>Item three</li>
        </ul>
    </Plain>
    <Bootstrapped>
        <ul class="list-group">
            <li class="list-group-item active">Item one</li>
            <li class="list-group-item">Item two</li>
            <li class="list-group-item d-flex justify-content-between">
                Item three <span class="badge text-bg-primary rounded-pill">3</span>
            </li>
        </ul>
    </Bootstrapped>
</Compare>

<Compare Title="Cards">
    <Plain>
        <div>
            <h3>Card title</h3>
            <p>Some example text that sits in the card body.</p>
            <a href="#">Go somewhere</a>
        </div>
    </Plain>
    <Bootstrapped>
        <div class="card" style="width: 18rem;">
            <div class="card-header">Header</div>
            <div class="card-body">
                <h3 class="card-title">Card title</h3>
                <p class="card-text">Some example text that sits in the card body.</p>
                <a href="#" class="btn btn-primary">Go somewhere</a>
            </div>
        </div>
    </Bootstrapped>
</Compare>

<Compare Title="Grid">
    <Plain>
        <div>
            <div style="width: 50%; float: left;">Left half</div>
            <div style="width: 50%; float: left;">Right half</div>
        </div>
        <div style="clear: both;"></div>
        <div>
            <div style="width: 33%; float: left;">Third 1</div>
            <div style="width: 33%; float: left;">Third 2</div>
            <div style="width: 33%; float: left;">Third 3</div>
        </div>
    </Plain>
    <Bootstrapped>
        <div class="container-fluid">
            <div class="row g-2 mb-2">
                <div class="col-6"><div class="border rounded bg-body-tertiary p-2">Left half</div></div>
                <div class="col-6"><div class="border rounded bg-body-tertiary p-2">Right half</div></div>
            </div>
            <div class="row g-2">
                <div class="col-4"><div class="border rounded bg-body-tertiary p-2">Third 1</div></div>
                <div class="col-4"><div class="border rounded bg-body-tertiary p-2">Third 2</div></div>
                <div class="col-4"><div class="border rounded bg-body-tertiary p-2">Third 3</div></div>
            </div>
        </div>
    </Bootstrapped>
</Compare>

<Compare Title="Spacing and utility classes">
    <Plain>
        <div>A box with manual margins and padding via inline styles.</div>
        <div>Another box with a gap between it.</div>
    </Plain>
    <Bootstrapped>
        <div class="p-3 mb-3 border rounded bg-body-tertiary">
            Same box using <code>p-3</code>, <code>mb-3</code>, <code>border</code>, <code>rounded</code>.
        </div>
        <div class="p-3 border rounded bg-primary text-white">
            Colored with <code>bg-primary</code> and <code>text-white</code>.
        </div>
    </Bootstrapped>
</Compare>

<Compare Title="Navigation bar">
    <Plain>
        <div>
            <strong>ProjectZero</strong>
            <a href="#">Home</a>
            <a href="#">Counter</a>
            <a href="#">Weather</a>
        </div>
    </Plain>
    <Bootstrapped>
        <nav class="navbar navbar-expand navbar-dark bg-dark rounded">
            <div class="container-fluid">
                <a class="navbar-brand" href="#">ProjectZero</a>
                <div class="navbar-nav">
                    <a class="nav-link active" href="#">Home</a>
                    <a class="nav-link" href="#">Counter</a>
                    <a class="nav-link" href="#">Weather</a>
                </div>
            </div>
        </nav>
    </Bootstrapped>
</Compare>
