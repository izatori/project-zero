@page "/hiragana/learn"
@* Route for this page. @rendermode enables interactive (Server) rendering. *@
@rendermode InteractiveServer
@* Using directives pull in the glyph DTOs, the glyph query and MediatR. *@
@using Core.Application.DTOs
@using Core.Application.Features.Glyphs.GetGlyphs
@using Core.Domain.Enums
@using MediatR
@* Injected services: ISender loads the glyphs once; IJSRuntime calls JS helpers (body scroll-lock + text fitting). *@
@inject ISender Sender
@inject IJSRuntime JS

<PageTitle>Learn Hiragana</PageTitle>

@* Pre-start view: page header, then the Basic Hiragana and Hiragana words sections. *@
<div class="playground-page py-4">
    <HiraganaNav />
    <div class="d-flex align-items-center mb-4 mt-2">
        <div class="me-3 d-flex align-items-center justify-content-center default-page-icon">
            <i class="bi bi-journal-bookmark p-3"></i>
        </div>
        <div>
            <h1 class="mb-0 fw-bold">Learn</h1>
            <p class="text-muted mb-0">Practice and study Hiragana in a structured way.</p>
        </div>
    </div>

    <div class="container px-0">
        @* Basic Hiragana section: one card per glyph (image + words). *@
        <HiraganaLearnSection Title="Basic Hiragana"
                              IconClass="bi-grid"
                              IsGlyphMode="true"
                              Glyphs="@_glyphs"
                              FocusChanged="OnFocusChanged" />

        @* Hiragana words section: one card per translation. *@
        <HiraganaLearnSection Title="Hiragana words"
                              IconClass="bi-journal-text"
                              IsGlyphMode="false"
                              Glyphs="@_glyphs"
                              FocusChanged="OnFocusChanged" />
    </div>
</div>

@* Floating help button, always visible, opens the guide modal below. *@
<button type="button" class="btn btn-help position-fixed bottom-0 end-0 m-4" @onclick="() => _showHelp = true"
        title="How to use the app" aria-label="Help">
    <i class="bi bi-question-lg"></i>
</button>

@* Help modal explaining the app's features. *@
@if (_showHelp)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content shadow">
                <div class="modal-header">
                    <h5 class="modal-title fw-semibold">
                        <i class="bi bi-lightbulb me-2 text-primary"></i>How to use the app
                    </h5>
                    <button type="button" class="btn-close" @onclick="() => _showHelp = false" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <ul class="list-unstyled mb-0">
                        <li class="mb-3">
                            <i class="bi bi-grid me-2 text-primary"></i>
                            <strong>Basic Hiragana</strong> — learn individual characters: glyph image on the front, the
                            romaji and example words on the back.
                        </li>
                        <li class="mb-3">
                            <i class="bi bi-journal-text me-2 text-primary"></i>
                            <strong>Hiragana words</strong> — practise whole words and their meanings.
                        </li>
                        <li class="mb-3">
                            <i class="bi bi-funnel me-2 text-primary"></i>
                            <strong>Filter</strong> — show All, only Not learned, or only Learned cards using the sidebar.
                        </li>
                        <li class="mb-3">
                            <i class="bi bi-play-circle me-2 text-primary"></i>
                            <strong>Start Learning</strong> — begins a session of randomized cards.
                        </li>
                        <li class="mb-3">
                            <i class="bi bi-chevron-left me-2 text-muted"></i>
                            <i class="bi bi-chevron-right me-2 text-muted"></i>
                            <strong>Next / Previous</strong> — move through the cards using the arrow buttons.
                        </li>
                        <li class="mb-3">
                            <i class="bi bi-arrow-repeat me-2 text-secondary"></i>
                            <strong>Reveal romaji</strong> — in the words section, hover the gray pill below the character to see the romaji.
                        </li>
                        <li class="mb-3">
                            <i class="bi bi-arrow-repeat me-2 text-secondary"></i>
                            <strong>Flip the card</strong> — click the card to see the image and meaning.
                        </li>
                        <li class="mb-3">
                            <i class="bi bi-check2-circle me-2 text-success"></i>
                            <strong>Mark as learned / not learned</strong> — the button below the card toggles its progress.
                        </li>
                        <li class="mb-3">
                            <i class="bi bi-star me-2 text-warning"></i>
                            <strong>Favourites</strong> — star a card to keep it handy. Favourites appear in the Favourites
                            filter regardless of whether they're learned or not.
                        </li>
                        <li>
                            <i class="bi bi-arrow-counterclockwise me-2 text-secondary"></i>
                            <strong>Restart</strong> — jump back to the first card.
                        </li>
                    </ul>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="() => _showHelp = false">Close</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@code {
    // Controls the help modal.
    private bool _showHelp;

    // True while one of the learning sections is in full-screen focus mode (used to lock body scrolling).
    private bool _focusActive;

    // All Hiragana glyphs, loaded once and shared by both learning sections.
    private IReadOnlyList<GlyphDto> _glyphs = Array.Empty<GlyphDto>();

    // Loads all Hiragana glyphs a single time (avoiding concurrent DbContext queries from the two sections).
    protected override async Task OnInitializedAsync()
    {
        var glyphs = await Sender.Send(new GetAllGlyphsQuery(GlyphType.Hiragana));
        _glyphs = glyphs.ToList();
    }

    // Called by a HiraganaLearnSection whenever it enters or leaves focus mode.
    private void OnFocusChanged(bool active)
    {
        _focusActive = active;
    }

    // After every render: sync the body scroll-lock with the active focus session.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JS.InvokeVoidAsync("setLearningFocus", _focusActive);
    }

    // When the component is removed (e.g. navigating to another page), release the body scroll-lock.
    public void Dispose()
    {
        try
        {
            _ = JS.InvokeVoidAsync("setLearningFocus", false);
        }
        catch
        {
            // Circuit may already be gone; ignore.
        }
    }
}