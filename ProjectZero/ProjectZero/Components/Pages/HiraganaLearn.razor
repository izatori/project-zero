@page "/hiragana/learn"
@rendermode InteractiveServer

<PageTitle>Learn Hiragana</PageTitle>

<div class="playground-page py-4">
    <HiraganaNav />
    <div class="d-flex align-items-center mb-4 mt-2">
        <div class="me-3 d-flex align-items-center justify-content-center default-page-icon">
            <i class="bi bi-journal-bookmark p-3"></i>
        </div>
        <div>
            <h1 class="mb-0 fw-bold">Learn</h1>
            <p class="text-muted mb-0">Practice and study Hiragana in a structured way.</p>
        </div>
    </div>

    <div class="container px-0">
        <div class="card shadow-sm border-0 text-center py-5">
            <div class="card-body py-5">
                <div class="mb-3">
                    <i class="bi bi-mortarboard" style="font-size: 3rem; color: #adb5bd;"></i>
                </div>
                <h4 class="fw-semibold">Learning mode is coming soon</h4>
                <p class="text-muted mb-4 col-md-6 mx-auto">
                    Guided lessons, quizzes and practice exercises for Hiragana will be available here shortly.
                    For now, head over to Discover to explore the characters or to Manage to add and edit them.
                </p>
                <a class="btn btn-primary px-4" href="/hiragana">
                    <i class="bi bi-compass me-2"></i>Go to Discover
                </a>
            </div>
        </div>
    </div>
</div>