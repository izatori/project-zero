@code {
    private string message = "Hello from a field";
    private bool showExtra = true;
    private bool showText = true;
    private string kind = "";
    private int count = 0;
    private string? boundText;
    private readonly List<string> fruits = new() { "Apple", "Banana", "Cherry" };

    private void Increment()
    {
        count++;
    }
}
