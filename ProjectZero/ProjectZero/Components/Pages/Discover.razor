@page "/hiragana"
@rendermode InteractiveServer
@using Core.Application.DTOs
@using Core.Application.Features.Glyphs.GetGlyphs
@using Core.Domain.Enums
@using MediatR
@inject ISender Sender

<PageTitle>Learn Hiragana</PageTitle>

<div class="playground-page py-4">
    <GlyphNav />
    <div class="d-flex align-items-center mb-4 mt-2">
        <div class="me-3 d-flex align-items-center justify-content-center default-page-icon">
            <i class="bi bi-translate p-3"></i>
        </div>
        <div>
            <h1 class="mb-0 fw-bold">Discover Hiragana and Katakana</h1>
            <p class="text-muted mb-0">Build a strong foundation for reading and understanding Japanese.</p>
        </div>
    </div>
    
  <div class="btn-group mb-4" role="group" aria-label="Basic radio toggle button group">
  <input type="radio" class="btn-check" name="btnradio" id="btnradio1" autocomplete="off" checked>
  <label class="btn btn-outline-dark" for="btnradio1">Hiragana</label>

  <input type="radio" class="btn-check" name="btnradio" id="btnradio2" autocomplete="off">
  <label class="btn btn-outline-dark" for="btnradio2">Katakana</label>

  <input type="radio" class="btn-check" name="btnradio" id="btnradio3" autocomplete="off">
  <label class="btn btn-outline-dark" for="btnradio3">All</label>
</div>
    <div class="container px-0">
        <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-lg-5 row-cols-xl-6 g-4">
            @foreach (var glyph in _glyphs)
            {
                <div class="col">
                    <GlyphCard Id="@glyph.Id"
                               Character="@glyph.Character"
                               Romaji="@glyph.Romaji"
                               ImageFileName="@glyph.ImageFileName"
                               StrokeAnimationFileName="@glyph.StrokeAnimationFileName"></GlyphCard>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private List<GlyphDto> _glyphs = new();

    protected override async Task OnInitializedAsync()
    {
        _glyphs = (await Sender.Send(new GetActiveGlyphsQuery(GlyphType.Hiragana))).ToList();
    }
}