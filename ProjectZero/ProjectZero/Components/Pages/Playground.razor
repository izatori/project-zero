@page "/playground"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Routing

<PageTitle>Playground</PageTitle>

<div class="playground-page py-4">
    <div class="d-flex align-items-center mb-5">
        <div class="me-3 d-flex align-items-center justify-content-center default-page-icon">
            <i class="bi bi-box-seam"></i>
        </div>
        <div>
            <h1 class="mb-0 fw-bold">Playground</h1>
            <p class="text-muted mb-0">Prove your concepts, test and learn about new features.</p>
        </div>
    </div>

    <div class="container px-0">
        <div class="row g-4">
            @foreach (var subPage in SubPages)
            {
                <div class="col-12 col-sm-6 col-lg-4">
                    <a class="text-decoration-none h-100" href="@subPage.Route">
                        <div class="card h-100 border-0 playground-tile shadow-sm">
                            <div class="card-body d-flex flex-column">
                                <div class="playground-tile-icon mb-3">
                                    <i class="bi @subPage.Icon"></i>
                                </div>
                                <h5 class="card-title fw-semibold mb-1">@subPage.Title</h5>
                                <p class="card-text text-muted mb-3">@subPage.Description</p>
                                <div class="mt-auto d-flex align-items-center">
                                    <span class="badge text-bg-primary-subtle">Explore</span>
                                    <i class="bi bi-arrow-right-circle ms-auto text-primary"></i>
                                </div>
                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private record SubPage(string Title, string Description, string Route, string Icon);

    private List<SubPage> SubPages { get; } = new()
    {
        new("Counter", "A simple interactive counter demonstrating event handling.",
            "/counter", "bi-123"),
        new("Weather", "Browse the weather forecast data bound to a table.",
            "/weather", "bi-cloud-sun"),
        new("Product Store", "Create and manage products in the catalog.",
            "/product-creator", "bi-box-seam"),
        new("Learn Hiragana", "Discover Hiragana characters and build a strong foundation for reading Japanese.",
            "/hiragana", "bi-translate"),
    };
}