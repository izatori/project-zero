@using Core.Application.DTOs
@using Core.Application.Features.Glyphs.SetGlyphLearned
@using Core.Application.Features.Glyphs.SetGlyphFavourite
@using Core.Application.Features.Translations.SetTranslationLearned
@using Core.Application.Features.Translations.SetTranslationFavourite
@using MediatR
@inject ISender Sender
@inject IJSRuntime JS

@* Pre-start section card: filter sidebar + Start Learning prompt or empty state. *@
<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white border-0 pt-4 pb-0">
        <h5 class="card-title fw-semibold mb-0">
            <i class="bi @IconClass me-2 text-primary"></i>@Title
        </h5>
        @* Header summary showing how many cards are in the current filter. *@
        <p class="text-muted small mb-0 mt-1">@HeaderSummary</p>
    </div>

    <div class="card-body">
        <div class="row g-4">
            @* Left sidebar with filter options and live counts. *@
            <div class="col-md-3">
                <div class="learning-filter">
                    <h6 class="fw-semibold text-uppercase small text-muted mb-2">
                        <i class="bi bi-funnel me-1"></i>Filter
                    </h6>
                    <div class="list-group list-group-flush">
                        <button type="button"
                                class="list-group-item list-group-item-action d-flex justify-content-between align-items-center @(_filter == LearningFilter.All ? "active" : "")"
                                @onclick="() => SetFilter(LearningFilter.All)">
                            All
                            <span class="badge text-bg-secondary rounded-pill">@_allCards.Count</span>
                        </button>
                        <button type="button"
                                class="list-group-item list-group-item-action d-flex justify-content-between align-items-center @(_filter == LearningFilter.NotLearned ? "active" : "")"
                                @onclick="() => SetFilter(LearningFilter.NotLearned)">
                            Not learned
                            <span class="badge text-bg-secondary rounded-pill">@_allCards.Count(c => !c.IsLearned)</span>
                        </button>
                        <button type="button"
                                class="list-group-item list-group-item-action d-flex justify-content-between align-items-center @(_filter == LearningFilter.Learned ? "active" : "")"
                                @onclick="() => SetFilter(LearningFilter.Learned)">
                            Learned
                            <span class="badge text-bg-secondary rounded-pill">@_allCards.Count(c => c.IsLearned)</span>
                        </button>
                        <button type="button"
                                class="list-group-item list-group-item-action d-flex justify-content-between align-items-center @(_filter == LearningFilter.Favourites ? "active" : "")"
                                @onclick="() => SetFilter(LearningFilter.Favourites)">
                            <span><i class="bi bi-star-fill me-1"></i>Favourites</span>
                            <span class="badge text-bg-secondary rounded-pill">@_allCards.Count(c => c.IsFavourite)</span>
                        </button>
                    </div>
                </div>
            </div>

            @* Main content: empty state or the Start Learning prompt. *@
            <div class="col">
                @if (_cards.Count == 0)
                {
                    <div class="learning-empty-state">
                        <img src="/images/glyphs/no-items-yet.jpg" alt="No items yet" />
                        <p>Seems like there is nothing here yet</p>
                    </div>
                }
                else if (!_started)
                {
                    <div class="text-center py-4">
                        <p class="text-muted mb-4 col-md-8 mx-auto">
                            You'll be shown a series of randomized cards. Start learning to flip through the @Title.ToLower().
                        </p>
                        @* Starting a session switches the section into the full-screen focus view. *@
                        <button type="button" class="btn btn-primary btn-lg px-5" @onclick="StartLearning">
                            <i class="bi bi-play-fill me-2"></i>Start Learning
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@* Full-screen focus view, shown once a session in this section starts. *@
@if (_started)
{
    <div class="learning-focus">
        @* Return button: leaves focus mode and goes back to the pre-start screen. *@
        <button type="button" class="btn btn-outline-secondary btn-sm learning-focus-return" @onclick="Return">
            <i class="bi bi-box-arrow-left me-1"></i>Return
        </button>

        @* Top navigation (Discover / Learn / Manage) stays available while focusing. *@
        <div class="learning-focus-nav">
            <HiraganaNav />
        </div>

        <div class="learning-focus-body">
            @* Compact filter control so the user can switch All / Not learned / Learned / Favourites mid-session. *@
            <div class="learning-focus-filter">
                <span class="learning-focus-filter-label"><i class="bi bi-funnel me-1"></i>Filter</span>
                <div class="btn-group btn-group-sm" role="group" aria-label="Filter">
                    <button type="button" class="btn @(_filter == LearningFilter.All ? "btn-primary" : "btn-outline-primary")"
                            @onclick="() => SetFilter(LearningFilter.All)">
                        All
                    </button>
                    <button type="button" class="btn @(_filter == LearningFilter.NotLearned ? "btn-primary" : "btn-outline-primary")"
                            @onclick="() => SetFilter(LearningFilter.NotLearned)">
                        Not learned
                    </button>
                    <button type="button" class="btn @(_filter == LearningFilter.Learned ? "btn-primary" : "btn-outline-primary")"
                            @onclick="() => SetFilter(LearningFilter.Learned)">
                        Learned
                    </button>
                    <button type="button" class="btn @(_filter == LearningFilter.Favourites ? "btn-primary" : "btn-outline-primary")"
                            @onclick="() => SetFilter(LearningFilter.Favourites)">
                        <i class="bi bi-star-fill me-1"></i>Favourites
                    </button>
                </div>
            </div>

            @* Empty state: no cards match the active filter. *@
            @if (_cards.Count == 0)
            {
                <div class="learning-empty-state">
                    <img src="/images/glyphs/no-items-yet.jpg" alt="No items yet" />
                    <p>Seems like there is nothing here yet</p>
                </div>
            }
            else
            {
                @* Card row: previous button, the flip card, and next button. *@
                <div class="learning-card-row">
                    <button type="button" class="btn btn-outline-primary btn-lg"
                            title="Previous card"
                            disabled="@(_currentIndex == 0)"
                            @onclick="() => GoTo(_currentIndex - 1)">
                        <i class="bi bi-chevron-left"></i>
                    </button>

                    @* The flip card. Clicking toggles _flipped to show the back face. *@
                    <div class="learning-card @(_flipped ? "is-flipped" : "")" @onclick="ToggleFlip">
                        <div class="learning-card-inner">
                            @if (IsGlyphMode)
                            {
                                @* Basic Hiragana card. Front: glyph image + up to 2 Japanese texts. Back: animation/static image + romaji + up to 2 word columns. *@
                                <div class="learning-card-face learning-card-front">
                                    <img class="learning-card-glyph-image" src="/images/glyphs/hiragana/@Current.GlyphImageFileName" alt="@Current.Character" />
                                    <div class="learning-card-jp-texts">
                                        @foreach (var t in Current.Translations.Take(2))
                                        {
                                            <span class="learning-card-jp-text">@t.JapaneseWriting</span>
                                        }
                                    </div>
                                </div>
                                <div class="learning-card-face learning-card-back">
                                    <img class="learning-card-glyph-image"
                                         src="/images/glyphs/hiragana/@(string.IsNullOrEmpty(Current.GlyphAnimationFileName) ? Current.GlyphImageFileName : Current.GlyphAnimationFileName)"
                                         alt="@Current.Romaji" />
                                    <div class="learning-card-romaji">@Current.Romaji</div>
                                    <div class="learning-card-word-columns">
                                        @foreach (var t in Current.Translations.Take(2))
                                        {
                                            <div class="learning-card-word">
                                                <img class="learning-card-word-image"
                                                     src="@(string.IsNullOrEmpty(t.ImageFileName) ? "/images/glyphs/no-image-found.jpg" : $"/images/translations/{t.ImageFileName}")"
                                                     alt="@t.Translation" />
                                                <div class="learning-card-word-text">@t.Translation</div>
                                                <div class="learning-card-word-jp">@t.JapaneseWriting</div>
                                                <div class="learning-card-word-romaji">@t.RomajiWriting</div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                            else
                            {
                                @* Hiragana words card. Front: Japanese writing + hover-to-reveal romaji. Back: translation image + meaning. *@
                                <div class="learning-card-face learning-card-front">
                                    <h1 class="learning-card-char" @ref="_charElement">@Current.JapaneseWriting</h1>
                                    <div class="learning-romaji-hint">
                                        <span>@Current.RomajiWriting</span>
                                    </div>
                                </div>
                                <div class="learning-card-face learning-card-back">
                                    <img class="learning-card-image"
                                         src="@(string.IsNullOrEmpty(Current.TranslationImageFileName) ? "/images/glyphs/no-image-found.jpg" : $"/images/translations/{Current.TranslationImageFileName}")"
                                         alt="@Current.Translation" />
                                    <div class="learning-card-translation">@Current.Translation</div>
                                </div>
                            }
                        </div>
                    </div>

                    <button type="button" class="btn btn-outline-primary btn-lg"
                            title="Next card"
                            disabled="@(_currentIndex >= _cards.Count - 1)"
                            @onclick="() => GoTo(_currentIndex + 1)">
                        <i class="bi bi-chevron-right"></i>
                    </button>
                </div>

                @* Progress badge plus Restart (back to card 1) and Reshuffle (back to card 1 in a new random order) controls. *@
                <div class="mt-4 d-flex flex-column align-items-center gap-2">
                    <span class="badge text-bg-primary-subtle">Card @(_currentIndex + 1) of @_cards.Count</span>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="Restart">
                            <i class="bi bi-arrow-counterclockwise me-1"></i>Restart
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="Reshuffle">
                            <i class="bi bi-shuffle me-1"></i>Reshuffle
                        </button>
                    </div>
                </div>

                @* Learned and favourite toggles for the current card. Buttons change to reflect state. *@
                <div class="learning-focus-actions">
                    @if (Current.IsLearned)
                    {
                        <button type="button" class="btn btn-outline-warning" disabled="@_isBusy" @onclick="ToggleLearned">
                            <i class="bi bi-arrow-counterclockwise me-1"></i>Mark as not learned
                        </button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-outline-success" disabled="@_isBusy" @onclick="ToggleLearned">
                            <i class="bi bi-check2-circle me-1"></i>Mark as learned
                        </button>
                    }

                    @if (Current.IsFavourite)
                    {
                        <button type="button" class="btn btn-outline-danger" disabled="@_isBusy" @onclick="ToggleFavourite">
                            <i class="bi bi-star-fill me-1"></i>Remove favourite
                        </button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-outline-warning" disabled="@_isBusy" @onclick="ToggleFavourite">
                            <i class="bi bi-star me-1"></i>Set as favourite
                        </button>
                    }
                </div>

                @* Show any error thrown while saving a learned/favourite change. *@
                @if (_toggleError is not null)
                {
                    <div class="alert alert-danger mt-3 py-2 small mx-auto" style="max-width: 28rem;">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i>@_toggleError
                    </div>
                }
            }
        </div>
    </div>
}

@code {
    // Whether this section presents one card per glyph (Basic Hiragana) instead of one card per translation (words).
    [Parameter] public bool IsGlyphMode { get; set; }

    // The section title shown in the pre-start card header.
    [Parameter] public string Title { get; set; } = "";

    // Bootstrap icon class used in the pre-start card header.
    [Parameter] public string IconClass { get; set; } = "bi-mortarboard";

    // All Hiragana glyphs, loaded once by the page and shared by both sections.
    [Parameter] public IReadOnlyList<GlyphDto> Glyphs { get; set; } = Array.Empty<GlyphDto>();

    // Notifies the page when this section enters/leaves focus so the body scroll-lock is managed once.
    [Parameter] public EventCallback<bool> FocusChanged { get; set; }

    // All loaded cards (unfiltered). Used as the source for filters and counts.
    private List<LearningCardItem> _allCards = new();
    // The cards currently shown, derived from _allCards via the active filter.
    private List<LearningCardItem> _cards = new();
    // Active filter selection.
    private LearningFilter _filter = LearningFilter.All;
    // True once the user presses Start Learning; switches to the full-screen focus view.
    private bool _started;
    // Index of the card currently on screen.
    private int _currentIndex;
    // True when the card is showing its back face.
    private bool _flipped;
    // Prevents double-submits while a learned/favourite change is being saved.
    private bool _isBusy;
    // Holds the last error message from a toggle, shown as an alert.
    private string? _toggleError;

    // Reference to the card's character element so JS can shrink large text to fit (words mode only).
    private ElementReference _charElement;

    // The last Glyphs reference the deck was built from, used to rebuild when the page finishes loading them.
    private IReadOnlyList<GlyphDto>? _builtGlyphs;

    // Convenience accessor for the currently displayed card.
    private LearningCardItem Current => _cards[_currentIndex];

    // Header summary text based on the current filter count.
    private string HeaderSummary => _cards.Count > 0
        ? (IsGlyphMode
            ? $"{_cards.Count} Hiragana character card(s) ready. Flip each card to reveal the meaning."
            : $"{_cards.Count} translation card(s) ready. Flip each card to reveal the meaning.")
        : "No cards match the current filter.";

    // The available deck filters.
    private enum LearningFilter
    {
        All,
        NotLearned,
        Learned,
        Favourites
    }

    // Immutable view model for one learning card.
    private record LearningCardItem(
        Guid GlyphId,
        Guid? TranslationId,
        bool IsLearned,
        bool IsFavourite,
        string JapaneseWriting,
        string RomajiWriting,
        string Translation,
        string? TranslationImageFileName,
        string Character,
        string GlyphImageFileName,
        string? GlyphAnimationFileName,
        string Romaji,
        IReadOnlyList<TranslationDto> Translations);

    // Rebuilds the deck (glyph-level or translation-level depending on mode) from the glyphs loaded by the page.
    // The page loads glyphs asynchronously after the initial render, so rebuild whenever the Glyphs reference changes.
    protected override void OnParametersSet()
    {
        if (_builtGlyphs is null || !ReferenceEquals(_builtGlyphs, Glyphs))
        {
            _builtGlyphs = Glyphs;
            BuildDeck();
        }
    }

    private void BuildDeck()
    {
        if (IsGlyphMode)
        {
            _allCards = Glyphs.Select(g => new LearningCardItem(
                g.Id,
                null,
                g.IsLearned,
                g.IsFavourite,
                "",
                "",
                "",
                null,
                g.Character,
                g.ImageFileName,
                g.StrokeAnimationFileName,
                g.Romaji,
                g.Translations.ToList())).ToList();
        }
        else
        {
            _allCards = Glyphs
                .SelectMany(g => g.Translations.Select(t => (GlyphId: g.Id, Translation: t)))
                .Where(x => !string.IsNullOrWhiteSpace(x.Translation.JapaneseWriting) && !string.IsNullOrWhiteSpace(x.Translation.Translation))
                .Select(x => new LearningCardItem(
                    x.GlyphId,
                    x.Translation.Id,
                    x.Translation.IsLearned,
                    x.Translation.IsFavourite,
                    x.Translation.JapaneseWriting,
                    x.Translation.RomajiWriting,
                    x.Translation.Translation,
                    x.Translation.ImageFileName,
                    "",
                    "",
                    null,
                    "",
                    Array.Empty<TranslationDto>())).ToList();
        }

        ApplyFilter();
    }

    // After every render: shrink oversized card text (words mode only).
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!IsGlyphMode && _started && _cards.Count > 0)
        {
            await JS.InvokeVoidAsync("fitTextToWidth", _charElement, 128, 16);
        }
    }

    // Enters the full-screen learning session and notifies the page to lock body scrolling.
    private async Task StartLearning()
    {
        _currentIndex = 0;
        _flipped = false;
        _started = true;
        await FocusChanged.InvokeAsync(true);
    }

    // Exits the full-screen session back to the pre-start screen and releases the body scroll-lock.
    private async Task Return()
    {
        _started = false;
        await FocusChanged.InvokeAsync(false);
    }

    // Moves to a specific card, clamping invalid indices and resetting the flip state.
    private void GoTo(int index)
    {
        if (index < 0 || index >= _cards.Count)
        {
            return;
        }

        _currentIndex = index;
        _flipped = false;
    }

    // Jumps back to the first card.
    private void Restart()
    {
        _currentIndex = 0;
        _flipped = false;
    }

    // Restarts the session and reshuffles the deck into a new random order.
    private void Reshuffle()
    {
        Shuffle(_cards);
        _currentIndex = 0;
        _flipped = false;
    }

    // Flips the card between its front and back faces.
    private void ToggleFlip()
    {
        _flipped = !_flipped;
    }

    // Changes the active filter (no-op if it's already selected) and rebuilds the deck.
    private void SetFilter(LearningFilter filter)
    {
        if (_filter == filter)
        {
            return;
        }

        _filter = filter;
        ApplyFilter();
    }

    // Rebuilds the visible deck from _allCards based on the active filter, then shuffles and resets.
    private void ApplyFilter()
    {
        _cards = _filter switch
        {
            LearningFilter.NotLearned => _allCards.Where(c => !c.IsLearned).ToList(),
            LearningFilter.Learned => _allCards.Where(c => c.IsLearned).ToList(),
            LearningFilter.Favourites => _allCards.Where(c => c.IsFavourite).ToList(),
            _ => _allCards.ToList()
        };

        Shuffle(_cards);
        _currentIndex = 0;
        _flipped = false;
    }

    // Toggles the current card's learned state and persists it.
    private async Task ToggleLearned()
    {
        var card = Current;
        var markedLearned = !card.IsLearned;

        _isBusy = true;
        _toggleError = null;

        try
        {
            // Persist the change via a command (glyph-level in glyph mode, translation-level otherwise).
            if (IsGlyphMode)
            {
                await Sender.Send(new SetGlyphLearnedCommand(card.GlyphId, markedLearned));
            }
            else
            {
                await Sender.Send(new SetTranslationLearnedCommand(
                    card.TranslationId!.Value,
                    markedLearned));
            }

            // Keep both lists in sync with the new learned state.
            var allIndex = _allCards.FindIndex(c => SameCard(c, card));
            if (allIndex >= 0)
            {
                _allCards[allIndex] = _allCards[allIndex] with { IsLearned = markedLearned };
            }

            var deckIndex = _cards.FindIndex(c => SameCard(c, card));
            if (deckIndex >= 0)
            {
                _cards[deckIndex] = _cards[deckIndex] with { IsLearned = markedLearned };

                // If the card no longer fits the active filter, remove it and advance to the next.
                if (!MatchesFilter(_cards[deckIndex]))
                {
                    _cards.RemoveAt(deckIndex);
                    _currentIndex = _cards.Count == 0 ? 0 : Math.Min(deckIndex, _cards.Count - 1);
                }
                else if (markedLearned)
                {
                    // Marking a card as learned advances to the next one.
                    _currentIndex = Math.Min(_currentIndex + 1, _cards.Count - 1);
                }
            }

            _flipped = false;
        }
        catch (Exception ex)
        {
            _toggleError = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    // Toggles the current card's favourite state and persists it.
    private async Task ToggleFavourite()
    {
        var card = Current;
        var newValue = !card.IsFavourite;

        _isBusy = true;
        _toggleError = null;

        try
        {
            // Persist the change via a command (glyph-level in glyph mode, translation-level otherwise).
            if (IsGlyphMode)
            {
                await Sender.Send(new SetGlyphFavouriteCommand(card.GlyphId, newValue));
            }
            else
            {
                await Sender.Send(new SetTranslationFavouriteCommand(
                    card.TranslationId!.Value,
                    newValue));
            }

            // Keep both lists in sync with the new favourite state.
            var allIndex = _allCards.FindIndex(c => SameCard(c, card));
            if (allIndex >= 0)
            {
                _allCards[allIndex] = _allCards[allIndex] with { IsFavourite = newValue };
            }

            var deckIndex = _cards.FindIndex(c => SameCard(c, card));
            if (deckIndex >= 0)
            {
                _cards[deckIndex] = _cards[deckIndex] with { IsFavourite = newValue };

                // Removing a favourite while in the Favourites filter removes the card from the deck.
                if (!MatchesFilter(_cards[deckIndex]))
                {
                    _cards.RemoveAt(deckIndex);
                    _currentIndex = _cards.Count == 0 ? 0 : Math.Min(deckIndex, _cards.Count - 1);
                }
            }

            _flipped = false;
        }
        catch (Exception ex)
        {
            _toggleError = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    // Determines whether a card still belongs to the active filter.
    private bool MatchesFilter(LearningCardItem card)
    {
        return _filter switch
        {
            LearningFilter.NotLearned => !card.IsLearned,
            LearningFilter.Learned => card.IsLearned,
            LearningFilter.Favourites => card.IsFavourite,
            _ => true
        };
    }

    // Compares two cards. In glyph mode cards are unique per glyph; in words mode the translation id disambiguates.
    private static bool SameCard(LearningCardItem a, LearningCardItem b)
    {
        if (a.GlyphId != b.GlyphId)
        {
            return false;
        }

        if (a.TranslationId is not null && b.TranslationId is not null)
        {
            return a.TranslationId == b.TranslationId;
        }

        return a.TranslationId is null && b.TranslationId is null;
    }

    // Fisher-Yates shuffle, used to randomize the deck order.
    private static void Shuffle<T>(List<T> list)
    {
        for (int i = list.Count - 1; i > 0; i--)
        {
            int j = Random.Shared.Next(i + 1);
            (list[i], list[j]) = (list[j], list[i]);
        }
    }
}