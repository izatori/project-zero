@using Core.Application.Features.Products.DeleteProduct
@using MediatR
@inject ISender Sender
@inject NavigationManager Navigation

<div class="card h-100 border-0 product-card">
    <div class="card-body">
        <div class="product-card-image">
            <img src="/images/@FileName" alt="@FileName" class="card-img-top">
            <div class="product-card-overlay">
                <button type="button" class="btn btn-primary btn-sm rounded-circle action-btn" aria-label="Edit product">
                    <i class="bi bi-pencil"></i>
                </button>
                <button type="button" class="btn btn-danger btn-sm rounded-circle action-btn" @onclick="HandleDelete" aria-label="Delete product">
                    <i class="bi bi-trash"></i>
                </button>
            </div>
        </div>
        <p class="h5 card-title">@Name</p>
        <p class="card-text roboto-dark">@Description</p>
    </div>
</div>

@code
{
    [Parameter] public Guid ProductId { get; set; }
    
    [Parameter] public string? Name { get; set; }
    
    [Parameter] public string? FileName { get; set; }
    
    [Parameter] public double Price { get; set; }
    
    [Parameter] public string? Description { get; set; }

    private async Task HandleDelete()
    {
        await Sender.Send(new DeleteProductCommand(ProductId));
        
        Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
    }
}
